# Copy to .env and fill in. .env is gitignored. Never commit real values.
# In the Claude cloud container these are set as environment variables instead.

# OpenAlex (free key, required for API list calls since 2026)
OPENALEX_API_KEY=

# Copernicus Data Space Ecosystem S3 keys (free account; dashboard > S3 credentials)
CDSE_S3_ACCESS_KEY=
CDSE_S3_SECRET_KEY=

# Global Fishing Watch API token (CC BY-NC 4.0: noncommercial use only)
GFW_API_TOKEN=

# NASA Earthdata user token (urs.earthdata.nasa.gov): Black Marble, chlorophyll, 1 km SST
EARTHDATA_TOKEN=

# Copernicus Marine account (marine.copernicus.eu): chlorophyll, SST, currents
CMEMS_USERNAME=
CMEMS_PASSWORD=

# Earth Observation Group (eogdata.mines.edu), only for their VIIRS Boat Detection product
EOG_USER=
EOG_PASSWORD=
