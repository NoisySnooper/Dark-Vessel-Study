# ---- Secrets: never commit ----
.env
.env.*
!.env.example
.netrc
*.pem
*.key
secrets/
credentials*.json

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/
.venv/
/build/
dist/

# ---- Data: raw and heavy files stay out of git ----
# Small derived outputs (gpkg, csv under ~10 MB) ARE committed so they open in ArcGIS Pro.
data/raw/
data/cache/
data/interim/
data/chips/
data/cache/chips/
data/models/
data/*_perpol.gpkg
data/detections_regional_all.gpkg
data/viirs_lights_all.gpkg
data/outputs/demo/
*.SAFE/
*.zip
*.tar
*.tar.gz
*.nc
*.h5
*.pth
*.pt
*.npy
*.npz
# Rasters are reproducible from scripts; only small COGs under docs/ or data/outputs/small/ are kept
*.tif
*.tiff
!data/outputs/small/*.tif

# ---- ArcGIS Pro / OS clutter ----
*.lock
*.aux.xml
.DS_Store
Thumbs.db

# Run logs
*.log
data/ml/build_log.txt

# Research-only outputs (Global Fishing Watch, CC BY-NC 4.0): kept apart from product files
!data/research/*.tif

# Product app build artefacts
app/frontend/node_modules/
app/frontend/dist/
app/frontend/dist-single/
app/frontend/fixtures/*.html
app/frontend/checks/shots/
app/**/__pycache__/
# Single-file pages, reports and check screenshots of app/build/build_single.py (published as private artifacts, never committed)
app/build/out/

# Rebuilt in about 2 min by scripts/31_gfw_identity.py --steps outputs --offline (112 MB); the parquet is the committed copy
data/research/regional_identity.gpkg
# Rebuilt by scripts/33_leads.py --build research (85 MB, per-row evidence); data/research/leads_research.parquet is the committed copy
data/research/leads_research.gpkg
